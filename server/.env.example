# Server
PORT=3000
NODE_ENV=development

# Supabase (required)
# Find these in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# Find this in: Supabase Dashboard -> Project Settings -> API -> JWT Settings
JWT_SECRET=your-supabase-jwt-secret

# Google Maps (optional; required only for place search and reverse geocoding)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SMS / Twilio (optional; development uses a mock when omitted)
SMS_PROVIDER_API_KEY=mock-sms-key
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloudinary (optional; defaults are currently provided by the application)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
