        "body": {
          "mode": "raw",
          "raw": "{\n  \"pickupAddress\": \"123 Indiranagar, Main Road\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560038\",\n  \"latitude\": 12.9716,\n  \"longitude\": 77.5946\n}"
        },
        "url": {
