    {
      "name": "13. Delete Draft Car",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/cars/{{carId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "cars", "{{carId}}"]
        }
      },
      "response": []
